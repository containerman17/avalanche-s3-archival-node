@@ -0,0 +1,29 @@
+// Copyright (C) 2019, Ava Labs, Inc. All rights reserved.
+// See the file LICENSE for licensing terms.
+
+package core
+
+import (
+	"github.com/ava-labs/libevm/common"
+	"github.com/ava-labs/libevm/libevm/register"
+	"github.com/ava-labs/libevm/triedb"
+)
+
+// RevisionTrieDB manages a separate state database whose persistence can lag
+// the block database. Recovery restores its block identity or resets its state.
+// Firewood and replacement backends use the same recovery operations.
+type RevisionTrieDB interface {
+	SetHashAndHeight(common.Hash, uint64)
+	ClearAll() error
+}
+
+var trieDBConstructor register.AtMostOnce[func(*CacheConfig) triedb.DBConstructor]
+
+// RegisterTrieDBConstructor installs a backend selector before VM startup.
+// It must be called at most once. Returning nil preserves the stock constructor.
+func RegisterTrieDBConstructor(selectBackend func(*CacheConfig) triedb.DBConstructor) {
+	if selectBackend == nil {
+		panic("nil trie database constructor selector")
+	}
+	trieDBConstructor.MustRegister(selectBackend)
+}
